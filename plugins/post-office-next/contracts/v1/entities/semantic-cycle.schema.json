{
  "$id": "https://local.codex/post-office-next/contracts/v1/entities/semantic-cycle.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "examples": [
    {
      "id": "PON-CYCLE-001",
      "nonClaims": [],
      "openingAuthorityId": "PON-AUTHOR-ACTION-001",
      "projectId": "PON-PROJECT-001",
      "schemaVersion": "1",
      "scope": "Bounded work",
      "state": "OPEN"
    }
  ],
  "properties": {
    "acceptanceDecisionId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "closureAuthorityId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "nonClaims": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "openingAuthorityId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "OPEN",
        "ACTIVE",
        "AWAITING_REVIEW",
        "ACCEPTED",
        "CLOSED"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "scope",
    "openingAuthorityId",
    "state",
    "nonClaims"
  ],
  "title": "semantic-cycle",
  "type": "object"
}

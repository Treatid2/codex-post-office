        "localProject": "L:/Codex/projects/example"
      },
      "schemaVersion": "1",
      "status": "ACTIVE"
    }
  ],
  "properties": {
    "aggregateRoot": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "aggregateVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "authorityIds": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "code": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "createdEventId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "INTEGRATION",
        "PACKAGE_DEVELOPMENT",
        "INFRASTRUCTURE",
        "RESEARCH",
        "EVALUATION"
      ],
      "minLength": 1,
      "type": "string"
    },
    "mailDomains": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "registers": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "roots": {
      "additionalProperties": false,
      "properties": {
        "localBackup": {
          "minLength": 1,
          "type": "string"
        },
        "localCas": {
          "minLength": 1,
          "type": "string"
        },
        "localProject": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "localProject",
        "localCas",
        "localBackup"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "1"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PROVISIONING",
        "ACTIVE",
        "PAUSED",
        "PROVISIONING_FAILED",
        "ARCHIVED"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "code",
    "displayName",
    "kind",
    "status",
    "authorityIds",
    "roots",
    "registers",
    "mailDomains",
    "createdEventId",
    "aggregateVersion",
    "aggregateRoot"
  ],
  "title": "project",
  "type": "object"
}

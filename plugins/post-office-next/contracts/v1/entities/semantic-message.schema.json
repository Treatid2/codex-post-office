{
  "$id": "https://local.codex/post-office-next/contracts/v1/entities/semantic-message.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "examples": [
    {
      "authorityBasisId": "PON-GRANT-001",
      "completionCriteria": "Return evidence",
      "contentRoot": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "domain": "PON",
      "id": "PON-MSG-001",
      "messageType": "HANDOFF",
      "recipientGeneration": 1,
      "recipientMailboxId": "PON-MAILBOX-002",
      "relatedMessageIds": [],
      "requestedAction": "Run bounded work",
      "schemaVersion": "1",
      "semanticCycleId": "PON-CYCLE-001",
      "senderEndpointId": "PON-ENDPOINT-001",
      "state": "REGISTERED"
    }
  ],
  "properties": {
    "authorityBasisId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "completionCriteria": {
      "minLength": 1,
      "type": "string"
    },
    "contentRoot": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "domain": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "messageType": {
      "minLength": 1,
      "type": "string"
    },
    "recipientGeneration": {
      "minimum": 1,
      "type": "integer"
    },
    "recipientMailboxId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "relatedMessageIds": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "requestedAction": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "semanticCycleId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "senderEndpointId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "DRAFT",
        "BUNDLED",
        "CUSTODY_RECORDED",
        "REGISTERED",
        "DELIVERED",
        "ACKNOWLEDGED",
        "RESPONSE_RETURNED",
        "REVIEWED",
        "CLOSED",
        "QUARANTINED",
        "SUPERSEDED_BEFORE_REGISTRATION",
        "CANCELLED_BEFORE_DELIVERY",
        "BLOCKED"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "domain",
    "messageType",
    "senderEndpointId",
    "recipientMailboxId",
    "recipientGeneration",
    "relatedMessageIds",
    "authorityBasisId",
    "requestedAction",
    "completionCriteria",
    "contentRoot",
    "semanticCycleId",
    "state"
  ],
  "title": "semantic-message",
  "type": "object"
}

      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "reference": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "minLength": 1,
            "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "reference"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "legacyCycleId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "semanticCycleId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "transportMessageIds": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "legacyCycleId",
    "transportMessageIds",
    "classification",
    "evidence",

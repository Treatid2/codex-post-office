{
  "$id": "https://local.codex/post-office-next/contracts/v1/entities/integration-candidate.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "examples": [
    {
      "configurationRoot": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "id": "PON-CANDIDATE-001",
      "interfaceVersions": {
        "PON-INTERFACE-001": "0.1.0"
      },
      "packageRoots": {
        "PON-PACKAGE-001": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "parentGenerationId": "PON-GEN-001",
      "projectId": "PON-PROJECT-001",
      "schemaVersion": "1",
      "state": "PROPOSED",
      "testResults": []
    }
  ],
  "properties": {
    "configurationRoot": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "interfaceVersions": {
      "additionalProperties": true,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "packageRoots": {
      "additionalProperties": true,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "parentGenerationId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "state": {
      "enum": [
        "PROPOSED",
        "VALIDATING",
        "VALIDATED",
        "ACCEPTED",
        "PARTIAL",
        "REJECTED",
        "SUPERSEDED"
      ],
      "minLength": 1,
      "type": "string"
    },
    "testResults": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidenceRoot": {
            "minLength": 1,
            "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "SKIPPED"
            ],
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "parentGenerationId",
    "packageRoots",
    "interfaceVersions",
    "configurationRoot",
    "testResults",
    "state"
  ],
  "title": "integration-candidate",
  "type": "object"
}

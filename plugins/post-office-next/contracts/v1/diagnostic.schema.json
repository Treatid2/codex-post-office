{
  "$id": "https://local.codex/post-office-next/contracts/v1/diagnostic.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "examples": [
    {
      "code": "PON_AUTHENTICATION_FAILED",
      "details": {},
      "message": "Example diagnostic",
      "retryable": false,
      "schemaVersion": "1",
      "severity": "ERROR"
    }
  ],
  "properties": {
    "code": {
      "enum": [
        "PON_AUTHENTICATION_FAILED",
        "PON_AUTHORIZATION_DENIED",
        "PON_CONCURRENCY_CONFLICT",
        "PON_CONTRACT_FIXTURE_UNEXPECTED",
        "PON_CONTRACT_INVALID",
        "PON_CREDENTIAL_INVALID",
        "PON_CUSTODY_NOT_VERIFIED",
        "PON_DATABASE_INVALID",
        "PON_IDEMPOTENCY_CONFLICT",
        "PON_INPUT_INVALID",
        "PON_INTERNAL_ERROR",
        "PON_KERNEL_ALREADY_BOOTSTRAPPED",
        "PON_KERNEL_NOT_BOOTSTRAPPED",
        "PON_LEGACY_SCHEMA_UNSUPPORTED",
        "PON_MIGRATION_MISMATCH",
        "PON_OBSERVATION_MISMATCH",
        "PON_OPERATION_NOT_IMPLEMENTED",
        "PON_OUTPUT_EXISTS",
        "PON_PATH_CONFLICT",
        "PON_PATH_NOT_FOUND",
        "PON_PRODUCTION_MUTATION_FORBIDDEN",
        "PON_RATE_LIMITED",
        "PON_RECONCILIATION_AMBIGUOUS",
        "PON_RECONCILIATION_DUPLICATE",
        "PON_RECONCILIATION_HASH_MISMATCH",
        "PON_RECONCILIATION_ORPHAN",
        "PON_SNAPSHOT_INTEGRITY_FAILURE",
        "PON_SNAPSHOT_SOURCE_CHANGED"
      ]
    },
    "details": {
      "type": "object"
    },
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "schemaVersion": {
      "const": "1"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "code",
    "message",
    "severity",
    "retryable",
    "details"
  ],
  "title": "Post Office Next diagnostic",
  "type": "object"
}
